APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Clave HMAC para firmar los QR de pago (mínimo 32 caracteres aleatorios)
QR_SECRET_KEY=
# Fuerza https:// en todas las URLs generadas (además de HSTS)
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rumberoapp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cifra el contenido de la sesión en la tabla `sessions` (recomendado)
SESSION_ENCRYPT=true
# Déjalo vacío para que se active solo cuando APP_URL usa https://
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================
# SEGURIDAD
# ============================================
# IPs/CIDR de proxies de confianza, separados por comas. NUNCA "*".
# Ej.: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# Aplica la Content-Security-Policy (true en producción; false = solo reporta)
SECURITY_CSP_ENFORCE=false
# Orígenes extra permitidos en script-src (CDN de analítica, chat, etc.)
SECURITY_CSP_EXTRA_SCRIPT_SRC=

# ============================================
# WEB PUSH (notificaciones al navegador)
# ============================================
# Genera las claves con: php artisan webpush:vapid
VAPID_SUBJECT=mailto:soporte@rumberoextremo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Tiempo de vida del mensaje en segundos
WEBPUSH_TTL=3600
# Icono que muestra la notificación del sistema
WEBPUSH_ICON=/assets/img/logo_sidebar.png

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# BNC (Banco Nacional de Crédito)
# ============================================================
# Sin BNC_MASTER_KEY la API de bancos y los pagos BNC fallan.
BNC_ENVIRONMENT=production
BNC_CLIENT_GUID=
BNC_MASTER_KEY=
BNC_WORKING_KEY=
BNC_MERCHANT_ID=
BNC_AUTH_API_URL=https://servicios.bncenlinea.com:16000/api/Auth/LogOn
BNC_C2P_API_URL=https://servicios.bncenlinea.com:16000/api/MobPayment/SendC2P
BNC_VPOS_API_URL=https://servicios.bncenlinea.com:16000/api/Transaction/Send
BNC_P2P_API_URL=https://servicios.bncenlinea.com:16000/api/Position/Validate
BNC_BANKS_API_URL=https://servicios.bncenlinea.com:16000/api/Services/Banks
BNC_RATES_API_URL=https://servicios.bncenlinea.com:16000/api/Services/BCVRates
BNC_LEGACY_LOGIN_URL=https://servicios.bncenlinea.com:16000/api/legacy/auth/log0n
BNC_DEBITO_SOLICITAR_URL=https://servicios.bncenlinea.com:16000/api/SIMF/DebitTokenRequest
BNC_DEBITO_EMITIR_URL=https://servicios.bncenlinea.com:16000/api/SIMF/DebitBeginner
BNC_DEBITO_REENVIAR_URL=https://servicios.bncenlinea.com:16000/api/debito/reenviar-sms

# ============================================================
# IA (chat de soporte)
# ============================================================
# Gemini (Google AI Studio). La clave nueva empieza por "AQ.".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=45
# Ponlo en true si el servidor valida correctamente la CA de Google.
GEMINI_VERIFY_TLS=false

# DeepSeek (respaldo). Formato sk-...
DEEPSEEK_API_KEY=